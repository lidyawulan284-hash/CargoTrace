							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"event_type\": \"SUEZ_TRANSIT\",\n    \"status\": \"IN_TRANSIT\",\n    \"location_name\": \"Suez Canal Northbound Convoy\",\n    \"latitude\": 30.5852,\n    \"longitude\": 32.2654,\n    \"event_time\": \"2026-11-26 10:00:00\",\n    \"description\": \"MV Thermopylae cleared Suez northbound convoy with all CBU EV deck lashings verified.\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/shipments/1/tracking", "host": ["{{baseUrl}}"], "path": ["shipments", "1", "tracking"] }
					}
				}
			]
		},
