						"body": {
							"mode": "raw",
							"raw": "{\n    \"exception_type\": \"PORT_CONGESTION\",\n    \"severity\": \"MEDIUM\",\n    \"description\": \"Antrean sandar kapal Ro-Ro di pelabuhan transit\",\n    \"delay_impact_hours\": 14\n}"
