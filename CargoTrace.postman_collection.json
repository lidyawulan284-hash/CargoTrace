{
	"info": {
		"_postman_id": "cargotrace-automotive-api-v2",
		"name": "CargoTrace Automotive & Vehicle Visibility REST API",
		"description": "Complete Laravel Sanctum REST API collection for CargoTrace — Global Automotive & Vehicle Shipment Visibility Platform (Ro-Ro Sea & Air Freight).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication (Sanctum)",
			"item": [
				{
					"name": "POST Register Customer",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Hendrik van Dijk\",\n    \"email\": \"hendrik@euroev-imports.test\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"company_name\": \"EuroEV Mobility Group BV\",\n    \"phone\": \"+31 10 882 4401\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"] }
					}
				},
				{
					"name": "POST Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@cargotrace.test\",\n    \"password\": \"password\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
					}
				},
				{
					"name": "POST Login (Logistics Operator)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"operator@cargotrace.test\",\n    \"password\": \"password\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
					}
				},
				{
					"name": "POST Login (Customer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"customer@cargotrace.test\",\n    \"password\": \"password\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
					}
				},
				{
					"name": "GET Current Authenticated User",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/user", "host": ["{{baseUrl}}"], "path": ["user"] }
					}
				},
				{
					"name": "POST Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/logout", "host": ["{{baseUrl}}"], "path": ["logout"] }
					}
				}
			]
		},
		{
			"name": "2. Public Vehicle Tracking",
			"item": [
				{
					"name": "GET Public Tracking by Shipment Number",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/public/track/CT-2026-RORO-8841",
							"host": ["{{baseUrl}}"],
							"path": ["public", "track", "CT-2026-RORO-8841"]
						}
					}
				}
			]
		},
		{
			"name": "3. Vehicle Shipments",
			"item": [
				{
					"name": "GET Shipments (Filtered & Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/shipments?status=IN_TRANSIT&is_delayed=1&per_page=10",
							"host": ["{{baseUrl}}"],
							"path": ["shipments"],
							"query": [
								{ "key": "status", "value": "IN_TRANSIT" },
								{ "key": "is_delayed", "value": "1" },
								{ "key": "per_page", "value": "10" }
							]
						}
					}
				},
				{
					"name": "POST Create Automotive Shipment with VIN Items",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"shipment_number\": \"CT-2026-RORO-9901\",\n    \"customer_id\": 3,\n    \"carrier_id\": 1,\n    \"origin_id\": 1,\n    \"destination_id\": 4,\n    \"cargo_type\": \"CBU_EV\",\n    \"total_weight_kg\": 8400,\n    \"total_volume_cbm\": 62.5,\n    \"expected_departure\": \"2026-11-28 08:00:00\",\n    \"expected_arrival\": \"2026-12-16 18:00:00\",\n    \"notes\": \"Ro-Ro deck 4 booking with UN3480 EV battery compliance certificate.\",\n    \"items\": [\n        {\n            \"vehicle_model\": \"Hyundai Ioniq 5 CBU\",\n            \"item_description\": \"Hyundai Ioniq 5 CBU AWD EU Spec\",\n            \"vin_number\": \"KMHKN81EFPU990101\",\n            \"cargo_category\": \"CBU_EV\",\n            \"quantity\": 4,\n            \"weight_kg\": 8400,\n            \"declared_value\": 216000,\n            \"hs_code\": \"8703.80.10\"\n        }\n    ]\n}"
						},
						"url": { "raw": "{{baseUrl}}/shipments", "host": ["{{baseUrl}}"], "path": ["shipments"] }
					}
				},
				{
					"name": "GET Shipment Details + Weather + Summary",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/shipments/1", "host": ["{{baseUrl}}"], "path": ["shipments", "1"] }
					}
				},
				{
					"name": "PATCH Update Shipment Metadata",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"notes\": \"Updated Ro-Ro deck inspection dossier and EU homologation clearance reference.\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/shipments/1", "host": ["{{baseUrl}}"], "path": ["shipments", "1"] }
					}
				},
				{
					"name": "DELETE Shipment (Admin Only)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/shipments/4", "host": ["{{baseUrl}}"], "path": ["shipments", "4"] }
					}
				}
			]
		},
		{
			"name": "4. Tracking Checkpoints (Append-Only FSM)",
			"item": [
				{
