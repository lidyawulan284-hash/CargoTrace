						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"INVESTIGATING\",\n    \"resolution_notes\": \"Coordinating with EU customs broker for UN3480 lithium battery test summary verification.\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/exceptions/1", "host": ["{{baseUrl}}"], "path": ["exceptions", "1"] }
					}
				},
				{
					"name": "PATCH Mark Exception RESOLVED",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"RESOLVED\",\n    \"resolution_notes\": \"EU Homologation & UN3480 lithium battery compliance cleared; consignment released for final voyage.\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/exceptions/1", "host": ["{{baseUrl}}"], "path": ["exceptions", "1"] }
					}
				}
			]
		},
